---
import site from '../content/site.json';
import arrowUpRight from '@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw';
import starIcon from '@phosphor-icons/core/assets/fill/star-fill.svg?raw';
import ghIcon from '@phosphor-icons/core/assets/fill/github-logo-fill.svg?raw';
import { repoStars } from '../lib/release';
const stars = await repoStars();
// compact, like GitHub's own badges: 30, 999, 1.2k, 12k, 120k: never wider than four characters
const compact = (n: number) => new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: n < 10_000 ? 1 : 0 }).format(n).toLowerCase();
interface Props { current?: 'home' | 'bench' }
const { current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!-- a floating pill, detached from the top, always on screen -->
<header class="bar">
  <nav class="pill" aria-label="Site">
    <a class="mark" href={`${base}/`} aria-label="blender-kiln, home">
      <img src={`${base}/assets/img/logo-72.webp`} alt="" width="28" height="28" />
      <span class="word">blender-kiln</span>
    </a>
    <span class="links">
      <a href={`${base}/#method`}>Method</a>
      <a href={`${base}/bench/`} aria-current={current === 'bench' ? 'page' : undefined}>Bench</a>
      <a href={`${base}/#animate`}>Animate</a>
      <a href={`${base}/#print`}>Print</a>
    </span>
    <a class="gh" data-gh href={site.repo} aria-label={stars != null ? `GitHub, ${stars} stars` : 'GitHub'}><span class="ghi" aria-hidden="true" set:html={ghIcon} /><span class="ghw">GitHub</span><span class="stars measure" aria-hidden="true" hidden={stars == null}><span class="star" set:html={starIcon} /><span data-stars>{stars != null ? compact(stars) : ''}</span></span><span class="ic" aria-hidden="true" set:html={arrowUpRight} /></a>
  </nav>
</header>

<script>
  // the build's count goes stale between daily rebuilds: ask GitHub again on load, once per visit, and keep
  // the built one if it does not answer (60 unauthenticated calls an hour per visitor is plenty)
  const gh = document.querySelector<HTMLAnchorElement>('[data-gh]')!;
  const show = (n: number) => {
    const out = gh.querySelector<HTMLElement>('[data-stars]')!;
    out.textContent = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: n < 10_000 ? 1 : 0 }).format(n).toLowerCase();
    out.parentElement!.hidden = false;
    gh.setAttribute('aria-label', `GitHub, ${n} stars`);
  };
  const KEY = 'kiln-stars';
  let cached: number | null = null;
  try { cached = Number(sessionStorage.getItem(KEY)) || null; } catch {}
  if (cached) show(cached);
  else fetch('https://api.github.com/repos/elithril/blender-kiln', { headers: { Accept: 'application/vnd.github+json' } })
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      if (typeof d?.stargazers_count !== 'number') return;
      show(d.stargazers_count);
      try { sessionStorage.setItem(KEY, String(d.stargazers_count)); } catch {}
    })
    .catch(() => {});

  // the fade on the links only when they actually overflow, and gone once scrolled to the end
  const links = document.querySelector<HTMLElement>('.bar .links')!;
  const edge = () => {
    const over = links.scrollWidth > links.clientWidth + 1;
    links.toggleAttribute('data-overflow', over);
    links.toggleAttribute('data-end', over && links.scrollLeft + links.clientWidth >= links.scrollWidth - 1);
  };
  new ResizeObserver(edge).observe(links);
  new ResizeObserver(edge).observe(gh);
  links.addEventListener('scroll', edge, { passive: true });
</script>

<style>
  .bar { position: fixed; top: 16px; left: 0; right: 0; z-index: 20; display: flex; justify-content: center; pointer-events: none; padding-inline: 12px; }
  .pill {
    pointer-events: auto;
    display: flex; align-items: center; gap: 4px;
    padding: 6px 6px 6px 14px; border-radius: 999px;
    background: var(--char); border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 rgb(255 238 220 / 0.06), 0 18px 40px -20px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%);
  }
  .mark { display: flex; align-items: center; gap: 8px; margin-right: 10px; text-decoration: none; font: 600 1rem var(--face-display); letter-spacing: -0.01em; color: var(--bone); }
  .links { display: flex; }
  .links a, .gh {
    padding: 8px 14px; border-radius: 999px; font-size: 0.9375rem; color: var(--ash); text-decoration: none;
    transition: color 0.3s var(--ease-spring), background 0.3s var(--ease-spring);
  }
  .links a:hover, .links a[aria-current='page'] { color: var(--bone); background: rgb(255 238 220 / 0.07); }
  .gh { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); background: var(--molten); font-weight: 600; }
  .gh:hover { color: var(--ink); background: var(--bone); }
  .ic { display: inline-flex; width: 16px; height: 16px; transition: transform 0.4s var(--ease-spring); }
  .ic :global(svg) { width: 100%; height: 100%; fill: currentColor; }
  .gh:hover .ic { transform: translate(2px, -2px); }
  .stars { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: rgb(20 13 7 / 0.14); font-size: 0.8125rem; font-weight: 500; }
  .star { display: inline-flex; width: 12px; height: 12px; }
  .star :global(svg) { width: 100%; height: 100%; fill: currentColor; }
  @media (prefers-reduced-transparency: reduce) { .pill { background: var(--char); backdrop-filter: none; } }
  .ghi { display: none; width: 18px; height: 18px; }
  .ghi :global(svg) { width: 100%; height: 100%; fill: currentColor; }
  /* the pill never grows past the screen: the logo and the GitHub button keep their size, the links give way */
  .pill { max-width: 100%; min-width: 0; }
  .mark, .gh { flex: none; }
  .links { min-width: 0; }
  @media (max-width: 560px) {
    .bar { padding-inline: 8px; }
    .word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .mark { margin-right: 2px; }
    .pill { padding-left: 10px; }
    .links a { padding: 8px 6px; font-size: 0.875rem; white-space: nowrap; }
    /* phones: the GitHub mark replaces the word and the arrow goes, the count stays */
    .gh { padding: 8px 10px; gap: 4px; font-size: 0.875rem; }
    .gh .ic, .ghw { display: none; }
    .ghi { display: inline-flex; }
    .stars { padding: 2px 6px; }
    /* the narrowest phones: whatever still does not fit scrolls sideways under a fade, rather than pushing
       the button off screen (the count only ever gets wider) */
    .links { overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
    .links::-webkit-scrollbar { display: none; }
    .links[data-overflow] { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 20px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 20px), transparent); }
    .links[data-overflow][data-end] { -webkit-mask-image: none; mask-image: none; }
  }
</style>
